NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Set to 1 if  app is behind a proxy (e.g., if you're using a reverse proxy like Nginx or a load balancer). This is important for correctly handling secure cookies and client IP addresses.
TRUST_PROXY=0

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=studentsapp
DATABASE_URL=postgres://postgres:change-me@localhost:5432/studentsapp


# jwt
JWT_ACCESS_SECRET=access-secret-example

# minutes
ACCESS_TOKEN_EXPIRATION=120
# days
REFRESH_TOKEN_EXPIRATION=30
RESEND_API_KEY=resend-api-key-example

#mb
S3_FILE_SIZE_LIMIT=10 
S3_BUCKET_NAME=s3-bucket-name-example
AWS_REGION=aws-region-example
AWS_ACCESS_KEY_ID=aws-access-key-id-example
AWS_SECRET_ACCESS_KEY=aws-secret-access-key-example
# only true on the demo environment: it unlocks "npm run demo:reset", which wipes the database
DEMO_MODE=false
