# Copy to .env next to docker-compose.yml. Read by "docker compose" itself, not by the apps
# (the backend has its own backend/.env).

# Show the demo login buttons and banner. Applied when the frontend image is built.
VITE_DEMO_MODE=false

# Only on a public server: also start Caddy for HTTPS, and say which domain it serves.
# The domain's DNS record must already point at the server.
# COMPOSE_PROFILES=prod
# DOMAIN=demo.example.com

# Only needed to send emails (not used in demo mode).
# RESEND_API_KEY=
